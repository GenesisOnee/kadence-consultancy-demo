{
  "Home": "<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_2\",\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-hero\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_3\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_3\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-eyebrow\"} -->\n<p class=\"fn-eyebrow\">Independent thinking. Practical progress.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/advancedheading {\"level\":1,\"uniqueID\":\"fieldnote_1\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-hero-title\"} -->\n<h1 class=\"kt-adv-headingfieldnote_1 fn-hero-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_1\">Clear decisions.<br>Stronger businesses.</h1>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"fn-lead\"} -->\n<p class=\"fn-lead\">A thoughtful approach to strategy, operations and change — designed for the moment your business is ready to move forward.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"fn-button\"} -->\n<div class=\"wp-block-button fn-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/approach/\">Explore our approach ↗</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"className\":\"fn-note\"} -->\n<p class=\"fn-note\">A fictional advisory studio. An editable WordPress demonstration.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n\n<!-- wp:kadence/column {\"id\":2,\"uniqueID\":\"fieldnote_4\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_4\"><div class=\"kt-inside-inner-col\"><!-- wp:html -->\n<div class=\"fn-visual\" role=\"img\" aria-label=\"A simple operating model: shared direction connects clear priorities with accountable action.\"><div class=\"fn-visual-label\"><span>A shared direction</span><span>Fig. 01</span></div><div class=\"fn-visual-top\">Make the next move clear.</div><div class=\"fn-visual-line\"></div><div class=\"fn-visual-branches\"><div class=\"fn-visual-step\"><b>01 / FOCUS</b>Choose what matters</div><div class=\"fn-visual-step\"><b>02 / FOLLOW THROUGH</b>Put it into practice</div></div><div class=\"fn-visual-footer\"><span class=\"fn-dot\"></span>Small steps. A consistent direction.</div></div>\n<!-- /wp:html --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->\n\n<!-- wp:html -->\n<div class=\"fn-kicker\" aria-label=\"Areas of focus\"><span>Strategy & priorities</span><span>Operations & delivery</span><span>Leadership & change</span></div>\n<!-- /wp:html -->\n\n<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_6\",\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-white fn-rule\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_7\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_7\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-eyebrow\"} -->\n<p class=\"fn-eyebrow\">How we think</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/advancedheading {\"uniqueID\":\"fieldnote_5\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-section-title\"} -->\n<h2 class=\"kt-adv-headingfieldnote_5 fn-section-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_5\">Less complexity.<br>More momentum.</h2>\n<!-- /wp:kadence/advancedheading --></div></div>\n<!-- /wp:kadence/column -->\n\n<!-- wp:kadence/column {\"id\":2,\"uniqueID\":\"fieldnote_8\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_8\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-lead\"} -->\n<p class=\"fn-lead\">Growing businesses rarely need another thick report. They need a clear view of what matters, a workable plan and a way to keep moving.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>Fieldnote is a fictional studio built around that idea. This sample demonstrates how a professional services website can communicate a clear offer without inflated promises.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->\n\n<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_12\",\"columns\":3,\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-white fn-grid\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_13\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_13\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-number\"} -->\n<p class=\"fn-number\">01</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/advancedheading {\"level\":3,\"uniqueID\":\"fieldnote_9\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-card-title\"} -->\n<h3 class=\"kt-adv-headingfieldnote_9 fn-card-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_9\">Find the right focus.</h3>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>Turn a long list of possibilities into a short list of decisions.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p><a href=\"/services/\" class=\"fn-arrow-link\">Strategy &amp; priorities ↗</a></p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n\n<!-- wp:kadence/column {\"id\":2,\"uniqueID\":\"fieldnote_14\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_14\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-number\"} -->\n<p class=\"fn-number\">02</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/advancedheading {\"level\":3,\"uniqueID\":\"fieldnote_10\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-card-title\"} -->\n<h3 class=\"kt-adv-headingfieldnote_10 fn-card-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_10\">Make work flow.</h3>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>Connect your process, people and tools so good intentions become daily practice.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p><a href=\"/services/\" class=\"fn-arrow-link\">Operations &amp; delivery ↗</a></p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n\n<!-- wp:kadence/column {\"id\":3,\"uniqueID\":\"fieldnote_15\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_15\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-number\"} -->\n<p class=\"fn-number\">03</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/advancedheading {\"level\":3,\"uniqueID\":\"fieldnote_11\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-card-title\"} -->\n<h3 class=\"kt-adv-headingfieldnote_11 fn-card-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_11\">Move forward together.</h3>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>Give your team a shared direction, clear ownership and room to adapt.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p><a href=\"/services/\" class=\"fn-arrow-link\">Leadership &amp; change ↗</a></p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->\n\n<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_17\",\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-rule\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_18\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_18\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-eyebrow\"} -->\n<p class=\"fn-eyebrow\">A practical rhythm</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/advancedheading {\"uniqueID\":\"fieldnote_16\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-section-title\"} -->\n<h2 class=\"kt-adv-headingfieldnote_16 fn-section-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_16\">From the first question<br>to the next right step.</h2>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"fn-lead\"} -->\n<p class=\"fn-lead\">A straightforward structure that leaves room for what you learn.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"fn-button\"} -->\n<div class=\"wp-block-button fn-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/approach/\">See the process ↗</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div></div>\n<!-- /wp:kadence/column -->\n\n<!-- wp:kadence/column {\"id\":2,\"uniqueID\":\"fieldnote_19\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_19\"><div class=\"kt-inside-inner-col\"><!-- wp:html -->\n<div class=\"fn-process\"><div><b>01</b><section><h3>Understand the situation.</h3><p>Listen, map the moving parts and agree on the problem worth solving.</p></section></div><div><b>02</b><section><h3>Choose a direction.</h3><p>Make the trade-offs visible and set a small number of practical priorities.</p></section></div><div><b>03</b><section><h3>Turn the plan into practice.</h3><p>Set ownership, test the first steps and review what changes.</p></section></div></div>\n<!-- /wp:html --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->\n\n<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_21\",\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-dark\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_22\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_22\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-eyebrow\"} -->\n<p class=\"fn-eyebrow\">A useful place to begin</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/advancedheading {\"uniqueID\":\"fieldnote_20\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-section-title\"} -->\n<h2 class=\"kt-adv-headingfieldnote_20 fn-section-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_20\">Start with the decision in front of you.</h2>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"fn-lead\"} -->\n<p class=\"fn-lead\">A good first conversation makes the challenge smaller and the next step clearer.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n\n<!-- wp:kadence/column {\"id\":2,\"uniqueID\":\"fieldnote_23\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_23\"><div class=\"kt-inside-inner-col\"><!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"fn-button\"} -->\n<div class=\"wp-block-button fn-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/contact/\">Explore the contact page ↗</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->",
  "Services": "<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_25\",\"columns\":1,\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-hero\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_26\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_26\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-eyebrow\"} -->\n<p class=\"fn-eyebrow\">Where we can help</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/advancedheading {\"level\":1,\"uniqueID\":\"fieldnote_24\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-hero-title\"} -->\n<h1 class=\"kt-adv-headingfieldnote_24 fn-hero-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_24\">Make the work<br>that matters work.</h1>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"fn-lead\"} -->\n<p class=\"fn-lead\">Three connected areas of support, shaped around the decision you need to make.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->\n\n<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_28\",\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-white fn-rule\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_29\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_29\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-eyebrow\"} -->\n<p class=\"fn-eyebrow\">01 / Strategy &amp; priorities</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/advancedheading {\"uniqueID\":\"fieldnote_27\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-section-title\"} -->\n<h2 class=\"kt-adv-headingfieldnote_27 fn-section-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_27\">Find the right focus.</h2>\n<!-- /wp:kadence/advancedheading --></div></div>\n<!-- /wp:kadence/column -->\n\n<!-- wp:kadence/column {\"id\":2,\"uniqueID\":\"fieldnote_30\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_30\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-lead\"} -->\n<p class=\"fn-lead\">Turn a long list of possibilities into a short list of decisions.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>An example engagement would define the decision, compare realistic options and produce a short priorities roadmap.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->\n\n<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_32\",\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-white fn-rule\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_33\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_33\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-eyebrow\"} -->\n<p class=\"fn-eyebrow\">02 / Operations &amp; delivery</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/advancedheading {\"uniqueID\":\"fieldnote_31\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-section-title\"} -->\n<h2 class=\"kt-adv-headingfieldnote_31 fn-section-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_31\">Make work flow.</h2>\n<!-- /wp:kadence/advancedheading --></div></div>\n<!-- /wp:kadence/column -->\n\n<!-- wp:kadence/column {\"id\":2,\"uniqueID\":\"fieldnote_34\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_34\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-lead\"} -->\n<p class=\"fn-lead\">Connect your process, people and tools so good intentions become daily practice.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>An example engagement would map one workflow, identify friction and agree on practical changes with the people who use it.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->\n\n<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_36\",\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-white fn-rule\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_37\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_37\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-eyebrow\"} -->\n<p class=\"fn-eyebrow\">03 / Leadership &amp; change</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/advancedheading {\"uniqueID\":\"fieldnote_35\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-section-title\"} -->\n<h2 class=\"kt-adv-headingfieldnote_35 fn-section-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_35\">Move forward together.</h2>\n<!-- /wp:kadence/advancedheading --></div></div>\n<!-- /wp:kadence/column -->\n\n<!-- wp:kadence/column {\"id\":2,\"uniqueID\":\"fieldnote_38\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_38\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-lead\"} -->\n<p class=\"fn-lead\">Give your team a shared direction, clear ownership and room to adapt.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>An example engagement would clarify responsibilities, establish a meeting rhythm and make progress visible.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->\n\n<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_40\",\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-dark\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_41\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_41\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-eyebrow\"} -->\n<p class=\"fn-eyebrow\">A useful place to begin</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/advancedheading {\"uniqueID\":\"fieldnote_39\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-section-title\"} -->\n<h2 class=\"kt-adv-headingfieldnote_39 fn-section-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_39\">Start with the decision in front of you.</h2>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"fn-lead\"} -->\n<p class=\"fn-lead\">A good first conversation makes the challenge smaller and the next step clearer.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n\n<!-- wp:kadence/column {\"id\":2,\"uniqueID\":\"fieldnote_42\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_42\"><div class=\"kt-inside-inner-col\"><!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"fn-button\"} -->\n<div class=\"wp-block-button fn-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/contact/\">Explore the contact page ↗</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->",
  "Approach": "<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_44\",\"columns\":1,\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-hero\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_45\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_45\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-eyebrow\"} -->\n<p class=\"fn-eyebrow\">The way we work</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/advancedheading {\"level\":1,\"uniqueID\":\"fieldnote_43\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-hero-title\"} -->\n<h1 class=\"kt-adv-headingfieldnote_43 fn-hero-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_43\">A clear process.<br>Room to adapt.</h1>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"fn-lead\"} -->\n<p class=\"fn-lead\">Good work starts with the right questions and improves through feedback.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->\n\n<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_48\",\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-white fn-rule\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_49\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_49\"><div class=\"kt-inside-inner-col\"><!-- wp:kadence/advancedheading {\"uniqueID\":\"fieldnote_46\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-section-title\"} -->\n<h2 class=\"kt-adv-headingfieldnote_46 fn-section-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_46\">01 / Understand.</h2>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>Start with the context: what is changing, what is getting in the way and what a useful outcome looks like. Agree on scope before choosing tools or producing a plan.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n\n<!-- wp:kadence/column {\"id\":2,\"uniqueID\":\"fieldnote_50\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_50\"><div class=\"kt-inside-inner-col\"><!-- wp:kadence/advancedheading {\"uniqueID\":\"fieldnote_47\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-section-title\"} -->\n<h2 class=\"kt-adv-headingfieldnote_47 fn-section-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_47\">02 / Make choices.</h2>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>Explore a small set of credible options. Make assumptions explicit, assess the trade-offs and decide where to focus first.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->\n\n<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_53\",\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-white\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_54\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_54\"><div class=\"kt-inside-inner-col\"><!-- wp:kadence/advancedheading {\"uniqueID\":\"fieldnote_51\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-section-title\"} -->\n<h2 class=\"kt-adv-headingfieldnote_51 fn-section-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_51\">03 / Put it into practice.</h2>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>Make the next steps concrete. Define who owns each action, what evidence will show progress and when the plan should be reviewed.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n\n<!-- wp:kadence/column {\"id\":2,\"uniqueID\":\"fieldnote_55\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_55\"><div class=\"kt-inside-inner-col\"><!-- wp:kadence/advancedheading {\"uniqueID\":\"fieldnote_52\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-section-title\"} -->\n<h2 class=\"kt-adv-headingfieldnote_52 fn-section-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_52\">04 / Learn and adjust.</h2>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>Review what happened against the original aim. Keep what works, change what does not and leave clear documentation for the next person.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->\n\n<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_57\",\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-dark\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_58\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_58\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-eyebrow\"} -->\n<p class=\"fn-eyebrow\">A useful place to begin</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/advancedheading {\"uniqueID\":\"fieldnote_56\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-section-title\"} -->\n<h2 class=\"kt-adv-headingfieldnote_56 fn-section-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_56\">Start with the decision in front of you.</h2>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"fn-lead\"} -->\n<p class=\"fn-lead\">A good first conversation makes the challenge smaller and the next step clearer.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n\n<!-- wp:kadence/column {\"id\":2,\"uniqueID\":\"fieldnote_59\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_59\"><div class=\"kt-inside-inner-col\"><!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"fn-button\"} -->\n<div class=\"wp-block-button fn-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/contact/\">Explore the contact page ↗</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->",
  "About": "<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_61\",\"columns\":1,\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-hero\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_62\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_62\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-eyebrow\"} -->\n<p class=\"fn-eyebrow\">About the demonstration</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/advancedheading {\"level\":1,\"uniqueID\":\"fieldnote_60\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-hero-title\"} -->\n<h1 class=\"kt-adv-headingfieldnote_60 fn-hero-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_60\">A considered presence<br>for a thoughtful business.</h1>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"fn-lead\"} -->\n<p class=\"fn-lead\">Fieldnote is a fictional management advisory studio created as an independent design and development sample.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->\n\n<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_65\",\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-white fn-rule\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_66\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_66\"><div class=\"kt-inside-inner-col\"><!-- wp:kadence/advancedheading {\"uniqueID\":\"fieldnote_63\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-section-title\"} -->\n<h2 class=\"kt-adv-headingfieldnote_63 fn-section-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_63\">Clear words. Useful structure.</h2>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>The site gives a small professional services business a simple way to explain what it does, how it works and where a visitor should go next. There are no invented testimonials, client logos or performance statistics.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>All six pages use WordPress content blocks. Kadence layout blocks and headings are mixed with standard Gutenberg paragraphs and buttons, so the core content remains editable.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n\n<!-- wp:kadence/column {\"id\":2,\"uniqueID\":\"fieldnote_67\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_67\"><div class=\"kt-inside-inner-col\"><!-- wp:kadence/advancedheading {\"uniqueID\":\"fieldnote_64\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-section-title\"} -->\n<h2 class=\"kt-adv-headingfieldnote_64 fn-section-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_64\">Built to be handed over.</h2>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>The sample uses the free Kadence Theme and Kadence Blocks plugin. Its source includes a reproducible WordPress Playground blueprint, page content and a small styling layer.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>This is a portfolio sample by GenesisOne, not a customer case study. Actual client projects require an agreed scope, supplied or approved content, access arrangements and milestone terms.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->\n\n<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_68\",\"columns\":1,\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_69\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_69\"><div class=\"kt-inside-inner-col\"><!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"fn-button\"} -->\n<div class=\"wp-block-button fn-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/notes/\">View the development notes ↗</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->",
  "Notes": "<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_71\",\"columns\":1,\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-hero\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_72\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_72\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-eyebrow\"} -->\n<p class=\"fn-eyebrow\">Development notes</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/advancedheading {\"level\":1,\"uniqueID\":\"fieldnote_70\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-hero-title\"} -->\n<h1 class=\"kt-adv-headingfieldnote_70 fn-hero-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_70\">A small site.<br>A clear handover.</h1>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"fn-lead\"} -->\n<p class=\"fn-lead\">What this demonstration includes, and what would still need agreement for a production launch.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->\n\n<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_75\",\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-white fn-rule\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_76\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_76\"><div class=\"kt-inside-inner-col\"><!-- wp:kadence/advancedheading {\"uniqueID\":\"fieldnote_73\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-section-title\"} -->\n<h2 class=\"kt-adv-headingfieldnote_73 fn-section-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_73\">Included in the sample.</h2>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>Six pages, shared navigation, responsive layouts and editable block content. Keyboard focus states and reduced-motion preferences are respected. The diagram is plain HTML and CSS, with a text alternative.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>The public blueprint runs WordPress 7.1.4, PHP 8.3, Kadence Theme 1.6.0 and Kadence Blocks 3.9.0. It uses the Playground SQLite integration for a portable demonstration.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n\n<!-- wp:kadence/column {\"id\":2,\"uniqueID\":\"fieldnote_77\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_77\"><div class=\"kt-inside-inner-col\"><!-- wp:kadence/advancedheading {\"uniqueID\":\"fieldnote_74\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-section-title\"} -->\n<h2 class=\"kt-adv-headingfieldnote_74 fn-section-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_74\">Production decisions.</h2>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>A production project would separately confirm hosting, domain configuration, backups, content approval, form delivery, privacy requirements and analytics consent. This demo has no analytics or working lead-capture form.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>A launch on a conventional MySQL hosting environment would need its own staging and deployment checks. Demo testing is not a production hosting guarantee.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->\n\n<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_78\",\"columns\":1,\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_79\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_79\"><div class=\"kt-inside-inner-col\"><!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"fn-button\"} -->\n<div class=\"wp-block-button fn-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/contact/\">Discuss a similar website ↗</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->",
  "Contact": "<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_81\",\"columns\":1,\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-hero\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_82\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_82\"><div class=\"kt-inside-inner-col\"><!-- wp:paragraph {\"className\":\"fn-eyebrow\"} -->\n<p class=\"fn-eyebrow\">Start a conversation</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/advancedheading {\"level\":1,\"uniqueID\":\"fieldnote_80\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-hero-title\"} -->\n<h1 class=\"kt-adv-headingfieldnote_80 fn-hero-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_80\">A useful next step<br>starts with a clear brief.</h1>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"fn-lead\"} -->\n<p class=\"fn-lead\">For a similar website, share the goal, page list, approved content and any platform requirements.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->\n\n<!-- wp:kadence/rowlayout {\"uniqueID\":\"fieldnote_84\",\"colLayout\":\"equal\",\"maxWidth\":1200,\"padding\":[0,0,0,0],\"kbVersion\":2,\"className\":\"fn-section fn-white fn-rule\"} -->\n<!-- wp:kadence/column {\"uniqueID\":\"fieldnote_85\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_85\"><div class=\"kt-inside-inner-col\"><!-- wp:kadence/advancedheading {\"uniqueID\":\"fieldnote_83\",\"typography\":\"Georgia\",\"loadGoogleFont\":false,\"fontWeight\":\"400\",\"className\":\"fn-section-title\"} -->\n<h2 class=\"kt-adv-headingfieldnote_83 fn-section-title wp-block-kadence-advancedheading\" data-kb-block=\"kb-adv-headingfieldnote_83\">Talk to the developer.</h2>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:paragraph {\"className\":\"fn-lead\"} -->\n<p class=\"fn-lead\">Fieldnote is a fictional business. This enquiry route goes to GenesisOne, the developer of this demonstration.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"\"} -->\n<p>A proposal can then define deliverables, timing, payment terms and the evidence needed for acceptance.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:kadence/column -->\n\n<!-- wp:kadence/column {\"id\":2,\"uniqueID\":\"fieldnote_86\",\"className\":\"\"} -->\n<div class=\"wp-block-kadence-column kadence-columnfieldnote_86\"><div class=\"kt-inside-inner-col\"><!-- wp:html -->\n<div class=\"fn-contact-box\"><p class=\"fn-eyebrow\">Project enquiries</p><h2 style=\"font-family:Georgia,serif;font-weight:400;font-size:30px;line-height:1.2\">Show us what you have in mind.</h2><p><a href=\"mailto:genesis@wizzardone.com?subject=WordPress%20project%20enquiry\">genesis@wizzardone.com ↗</a></p><p class=\"fn-note\">Please do not email passwords or private customer data. Access can be arranged after the project is agreed.</p></div>\n<!-- /wp:html --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->"
}